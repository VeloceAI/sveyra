APP_ENV=local
# Unauthenticated token minting for local work. Off by default; never set
# this anywhere reachable.
ENABLE_DEV_SESSION=false
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://sveyra:sveyra@localhost:5432/sveyra
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
MODEL_PROVIDER=openai
STORAGE_BACKEND=memory
GCS_BUCKET_NAME=
GCS_OBJECT_PREFIX=
MEDIA_ACCESS_URL_TTL_SECONDS=900
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AVATAR_BACKEND=sveyra
VISION_BACKEND=stub
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_VISION_MODEL_ID=gemini-3.1-flash-lite
VISION_TIMEOUT_SECONDS=30
STYLIST_BACKEND=stub
